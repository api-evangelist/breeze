                "description": "Limit of records to return"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Offset of records to return"
              },
              {
                "name": "include_failed",
                "value": "",
                "type": "query",
                "description": "Include failed rebalance history"
              },
              {
                "name": "fund_id",
                "value": "",
                "type": "path"
              }
            ],
