{
  "opencollection": "1.0.0",
  "info": {
    "name": "Breeze Admin User Data API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "User Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "get_user_balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/user-balances/:fund_user",
            "params": [
              {
                "name": "fund_user",
                "value": "",
                "type": "path",
                "description": "Fund user identifier"
              },
              {
                "name": "asset",
                "value": "",
                "type": "query",
                "description": "Filter by specific asset"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sort by balance"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort order: 'asc' or 'desc'"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "get_user_yield",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/user-yield/:fund_user",
            "params": [
              {
                "name": "fund_user",
                "value": "",
                "type": "path",
                "description": "Fund user identifier"
              },
              {
                "name": "fund_id",
                "value": "",
                "type": "query",
                "description": "Filter by specific fund"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
