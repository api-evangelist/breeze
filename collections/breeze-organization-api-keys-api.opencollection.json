{
  "opencollection": "1.0.0",
  "info": {
    "name": "Breeze Admin Organization API Keys API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Organization API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "get_organization_api_keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/organization/api-keys",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "create_organization_api_key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/organization/api-keys",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "update_organization_api_key",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:8080/organization/api-keys/:api_key_id",
            "params": [
              {
                "name": "api_key_id",
                "value": "",
                "type": "path",
                "description": "API key identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "delete_organization_api_key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:8080/organization/api-keys/:api_key_id",
            "params": [
              {
                "name": "api_key_id",
                "value": "",
                "type": "path",
                "description": "API key identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}