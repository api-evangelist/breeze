            "url": "http://localhost:8080/fund/:fund_id",
            "params": [
              {
                "name": "fund_id",
                "value": "",
                "type": "path",
                "description": "Fund identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "get_fund_apy",
